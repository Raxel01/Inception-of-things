# -*- mode: ruby -*-
# vi: set ft=ruby :

MEMORY_CAPACITY = 1024

RECOMMENDED_CPU = 1
CONTROLLER_IP = "192.168.56.115"

Vagrant.configure("2") do |config|

  config.vm.box = "bento/debian-13"
  config.vm.hostname = "abait-taS"

  config.vm.provider "virtualBox" do |provider|
    provider.name = "abait-taS"
    provider.cpus = RECOMMENDED_CPU
    provider.memory = MEMORY_CAPACITY
  end

  config.vm.network "private_network", ip: CONTROLLER_IP
  config.vm.network "forwarded_port", guest: 30443, host: 8080
  config.vm.provision :shell, name: "server_provision", path: "./scripts/init_infrastructure.sh"
end

